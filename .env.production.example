# Production env — copy to .env.production locally, then upload to Vercel Production (branch: main)
# Never commit real secrets. This file is gitignored. Restrict access to deploy owners only.
# See docs/setup/00-manual-setup-ui.md #2 for Vercel scoping.

# --- Core (required) ---
# Use Neon's POOLED URL for prod (Transaction mode, pooled + TLS)
DATABASE_URL=postgresql://user:password@ep-yyy-pooler.us-east-1.aws.neon.tech/app_db?sslmode=verify-full
# Must be your canonical production origin (https only) — live Production: solara-production.vercel.app
APP_URL=https://solara-production.vercel.app
# Optional connection pool cap per serverless instance (default 5)
DB_POOL_MAX=5

# --- Stripe LIVE mode (never test keys in production) ---
# From https://dashboard.stripe.com/dashboard
STRIPE_SECRET_KEY=sk_live_51H...
STRIPE_WEBHOOK_SECRET=whsec_live_...  # prod endpoint signing secret
STRIPE_PRICE_ID_MXN=price_1H...       # recurring live MXN price
STRIPE_PRICE_ID_USD=price_1H...       # optional live USD price
STRIPE_PREMIUM_PRICE_IDS=

# --- Geocoding / Maps (prod commercial keys) ---
# Production requires a proper commercial license — don't ship OSM evaluation tiles at scale
OPEN_METEO_API_KEY=your_production_customer_key
NEXT_PUBLIC_MAP_TILE_URL=https://your-tile-provider.example/{z}/{x}/{y}.png
PLACES_HOURLY_BUDGET=1000
NEXT_PUBLIC_MAP_ATTRIBUTION=Your provider attribution — plain text only

# --- Email (production provider) ---
MAIL_TRANSPORT=resend
MAIL_FROM=Solara <no-reply@your-domain.example>
MAIL_REPLY_TO=
RESEND_API_KEY=re_...
POSTMARK_SERVER_TOKEN=

# --- CSP rollout: enforce only after a clean observation window ---
CSP_MODE=report-only

# --- Local-only seed vars MUST NOT be set in Vercel ---
# ALLOW_LOCAL_SEED, ALLOW_LOCAL_SEED_IN_CI, LOCAL_SEED_PASSWORD are refused on Vercel and must stay empty here.
