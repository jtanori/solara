# Staging env — copy to .env.staging locally, then upload to Vercel Preview (branch: staging)
# Never commit real secrets. This file is gitignored.
# See docs/setup/00-manual-setup-ui.md #2 for Neon/Vercel UI steps.

# --- Core (required for app + Drizzle) ---
# Use Neon's POOLED URL for the app (contains "-pooler." + "?sslmode=verify-full")
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.us-east-1.aws.neon.tech/app_db?sslmode=verify-full
# Canonical Vercel Preview origin for staging (must be https) — live Preview: solara-stg.vercel.app
APP_URL=https://solara-stg.vercel.app
# Optional connection pool cap per serverless instance (default 5)
DB_POOL_MAX=5

# --- Stripe TEST mode (never live keys in staging) ---
# From https://dashboard.stripe.com/test/dashboard
STRIPE_SECRET_KEY=sk_test_51H...
STRIPE_WEBHOOK_SECRET=whsec_1H...  # from stripe listen or Dashboard → Webhooks → staging endpoint
STRIPE_PRICE_ID_MXN=price_1H...     # recurring MXN price (test)
STRIPE_PRICE_ID_USD=price_1H...     # optional recurring USD price (test)
# Optional comma-separated legacy price IDs (keep empty if not migrating old Premium)
STRIPE_PREMIUM_PRICE_IDS=

# --- Geocoding / Maps (isolated staging keys) ---
# Leave empty to use public Open-Meteo/Map tiles for evaluation
OPEN_METEO_API_KEY=
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
PLACES_HOURLY_BUDGET=1000
NEXT_PUBLIC_MAP_ATTRIBUTION=© OpenStreetMap contributors

# --- Email (staging provider sandbox) ---
MAIL_TRANSPORT=resend
MAIL_FROM=Solara <no-reply@staging.example.com>
MAIL_REPLY_TO=
RESEND_API_KEY=re_...
POSTMARK_SERVER_TOKEN=

# --- CSP rollout ---
CSP_MODE=report-only

# --- Migrations (NOT for Vercel env — keep only in your secure shell) ---
# Use Neon's DIRECT URL (no pooler) for `db-run` migrations:
# DATABASE_URL_DIRECT=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/app_db?sslmode=verify-full
