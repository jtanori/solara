# Staging env — copy to .env.staging locally, then upload to Vercel Preview (branch: staging)
# Never commit real secrets. This file is gitignored.
# See docs/setup/00-manual-setup-ui.md #2 for Neon/Vercel UI steps.

# --- Core (required for app + Drizzle) ---
# Use Neon's POOLED URL for the app (contains "-pooler." + "?sslmode=verify-full")
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.us-east-1.aws.neon.tech/app_db?sslmode=verify-full
# Canonical Vercel Preview origin for staging (must be https) — live Preview: solara-stg.vercel.app
APP_URL=https://solara-stg.vercel.app
# Optional app pool cap per serverless process (default 5, max 20)
DB_POOL_MAX=5
# Optional coordination pool cap per serverless process (default 3, max 10)
DB_COORDINATION_POOL_MAX=3
# Opt-in cutover only; normal deployments drain old instances and keep 0.
LIFECYCLE_ADVISORY_COMPAT=0

# --- Stripe TEST mode (never live keys in staging) ---
# From https://dashboard.stripe.com/test/dashboard
STRIPE_SECRET_KEY=sk_test_51H...
STRIPE_WEBHOOK_SECRET=whsec_1H...  # from stripe listen or Dashboard → Webhooks → staging endpoint
STRIPE_PRICE_ID_MXN=price_1H...     # recurring MXN price (test)
STRIPE_PRICE_ID_USD=price_1H...     # optional recurring USD price (test)
# Optional comma-separated legacy price IDs (keep empty if not migrating old Premium)
STRIPE_PREMIUM_PRICE_IDS=

# --- Geocoding / Maps (isolated staging keys) ---
# Leave empty to use public Open-Meteo/Map tiles for evaluation
OPEN_METEO_API_KEY=
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
PLACES_HOURLY_BUDGET=1000
NEXT_PUBLIC_MAP_ATTRIBUTION=© OpenStreetMap contributors

# --- Email (staging provider sandbox) ---
MAIL_TRANSPORT=resend
MAIL_FROM=Solara <no-reply@staging.example.com>
MAIL_REPLY_TO=
RESEND_API_KEY=re_...
POSTMARK_SERVER_TOKEN=

# --- CSP rollout ---
CSP_MODE=report-only

# --- Migrations (NOT for Vercel env — keep only in your secure shell) ---
# Use Neon's DIRECT URL (no pooler) for `db-run` migrations:
# DATABASE_URL_DIRECT=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/app_db?sslmode=verify-full

# --- Reading generation safety (#105/#108/#129) -----------------------------
# Keep OFF through safety rollout and until provider evaluation + output UI are ready.
READINGS_GENERATION_ENABLED=
# Account generation accepts only "chat-completions" with the profile below.
# "fixture" is for explicit offline pipeline simulations, never a real account fallback.
READINGS_PROVIDER=
READINGS_CHEAP_MODEL=
READINGS_STRONG_MODEL=
# MXN per million tokens. Must price the requested model and every declared served alias.
# Aliases currently must have identical rates to the requested model. No fixture defaults.
# {"model-id":{"inputMxnPerMillion":15,"outputMxnPerMillion":60}}
READINGS_MODEL_PRICES=
# Canonical HTTPS base URL, no credentials, query or fragment; redirects refused.
READINGS_API_BASE_URL=
# NON-SECRET processor policy and verified whole-input metering contract:
# {"id":"processor-id","name":"Actual processor name","policyVersion":"v1","inputTokenLimits":{"model-id":128000},"servedModels":{"model-id":["served-id"]}}
# Verify limits include ALL billed input (system/schema/framing). The full input
# cap is reserved, not a guessed token count. Unknown/incomplete profiles refuse dispatch.
# Provider/endpoint/privacy version changes require fresh consent; model changes never reset the offer.
READINGS_PROCESSOR_PROFILE=
# Add this LAST, directly in the secret manager; never in chat/Git or preview data.
READINGS_API_KEY=
# Per-attempt deadline INCLUDING response body: integer 1..15000 ms, default 15000.
# Whole dispatch budget 40s; durable run 45s; hosting must support the 60s route duration.
READINGS_REQUEST_TIMEOUT_MS=
