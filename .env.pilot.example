# Genuine-sampling pilot configuration (#103, #109) — EXAMPLE ONLY
#
# Copy to .env.pilot locally. Never commit a key, never load this file in Vercel,
# and never point it at a hosted database.
#
#   cp .env.pilot.example .env.pilot
#   DOTENV_CONFIG_PATH=.env.pilot npm run readings:sample -- --help
#
# The sampler loads its env file with dotenv *override*: keys defined here win
# over exported values, but keys omitted here do not clear the shell. Both
# controls are therefore pinned false below, and the sampler refuses a true
# value before it parses the command.
READINGS_GENERATION_ENABLED=false
READINGS_PAID_GENERATION_ENABLED=false

# Frozen for the 2026-11 pilots: OpenCode Go + DeepSeek. The processor name and
# policyVersion are provisional; #105 (Part A, package A6) must confirm the
# disclosed processor and retention wording before any qualification run.
READINGS_PROVIDER=chat-completions
READINGS_API_BASE_URL=https://opencode.ai/inference/go/v1
READINGS_CHEAP_MODEL=deepseek-v4.1-flash
READINGS_STRONG_MODEL=deepseek-v4-pro

# DeepSeek returns empty content when thinking is enabled and the output is
# capped, so the adapter sends the disabled value.
READINGS_THINKING=disabled

# Stable UUID for the OpenCode Go gateway header (x-opencode-session).
READINGS_OPENCODE_SESSION=

# MXN per million input/output tokens. Requested model and every served alias
# must be priced; aliases currently must share the requested model's rates.
READINGS_MODEL_PRICES={"deepseek-v4.1-flash":{"inputMxnPerMillion":6.0,"outputMxnPerMillion":24.0},"deepseek-v4-pro":{"inputMxnPerMillion":34.8,"outputMxnPerMillion":69.6}}

# Non-secret processor policy and verified whole-input metering contract.
# The TBD marker makes the sampler refuse (`sampling_profile_unqualified`) until
# #105 signs the disclosure and this version is replaced.
READINGS_PROCESSOR_PROFILE={"id":"opencode-console","name":"OpenCode Console","policyVersion":"TBD-105","inputTokenLimits":{"deepseek-v4.1-flash":6000,"deepseek-v4-pro":8000},"servedModels":{"deepseek-v4.1-flash":["deepseek-v4.1-flash"],"deepseek-v4-pro":["deepseek-v4-pro"]}}

# Per-attempt deadline including the response body: integer 1..15000 ms.
READINGS_REQUEST_TIMEOUT_MS=15000

# One profile per invocation. `--profile` must match this value, and dotenv
# override loads this file last: before the rich run, edit this line to
# READINGS_PAID_PROFILE=paid-rich-v1 (a shell assignment will not win).
READINGS_PAID_PROFILE=paid-core-v1

# Add the key last, only in the approved local environment. Never in Git,
# chat, Vercel Preview, or a command transcript.
READINGS_API_KEY=
