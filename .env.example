# Local database connection (do not commit real credentials)
DATABASE_URL=

# Optional connection pool cap per serverless instance (default 5, max 20)
DB_POOL_MAX=

# Canonical public origin, e.g. https://your-domain.example
APP_URL=

# Stripe server-side configuration
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MXN=
STRIPE_PRICE_ID_USD=
# Optional comma-separated legacy Premium price IDs
STRIPE_PREMIUM_PRICE_IDS=

# Optional commercial Open-Meteo key (server only)
OPEN_METEO_API_KEY=

# Optional public map-tile URL template and plain-text provider attribution.
# These values are visible in the browser; never put a private secret here.
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=

# Maximum upstream geocoding calls per hour (default 1000)
PLACES_HOURLY_BUDGET=

# Email delivery. Local development defaults to "outbox" and writes .mail-outbox/*.eml.
# Staging and production must use "resend" or "postmark" with the matching key.
MAIL_TRANSPORT=
MAIL_FROM=
MAIL_REPLY_TO=
RESEND_API_KEY=
POSTMARK_SERVER_TOKEN=

# CSP rollout: keep "report-only" until the observation window is clean, then set "enforce".
CSP_MODE=report-only

# Local-only seed scaffold (never set in staging or production; refused when CI/VERCEL is set)
# Guard: ALLOW_LOCAL_SEED must be "true" and DATABASE_URL must be loopback (localhost/127.0.0.1/::1/[::1]); host check is best-effort (tunnels appear as 127.0.0.1)
ALLOW_LOCAL_SEED=
# Set ALLOW_LOCAL_SEED_IN_CI=true only for disposable CI DB (127.0.0.1) to allow seeding subscription fixtures / gating checks
ALLOW_LOCAL_SEED_IN_CI=
# Shared password for local seeded accounts (min 12 chars, never commit a real value)
LOCAL_SEED_PASSWORD=

# --- Reading document generation (#103) -------------------------------------
# All optional. Generation is OFF unless READINGS_GENERATION_ENABLED=true.
# The provider/model are configuration, not code; prices are MXN per million
# tokens as JSON {"<model>":{"inputMxnPerMillion":n,"outputMxnPerMillion":n}}.
# An invalid or incomplete READINGS_MODEL_PRICES fails closed (no dispatch).
READINGS_GENERATION_ENABLED=
# "fixture" (deterministic, no network) or "chat-completions" (any OpenAI-
# compatible /chat/completions endpoint). An unset or unknown value disables
# generation: every section falls back to chart-grounded prose.
READINGS_PROVIDER=
READINGS_CHEAP_MODEL=
READINGS_STRONG_MODEL=
READINGS_MODEL_PRICES=
# Only for READINGS_PROVIDER=chat-completions. The adapter posts to
# ${READINGS_API_BASE_URL}/chat/completions with a Bearer key. Both are required;
# if either is missing the run degrades to `provider_unavailable`.
READINGS_API_BASE_URL=
READINGS_API_KEY=
# Per-attempt deadline in ms (default 60000).
READINGS_REQUEST_TIMEOUT_MS=
