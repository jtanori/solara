# Local database connection (do not commit real credentials)
DATABASE_URL=

# Optional app pool cap per serverless process (default 5, max 20)
DB_POOL_MAX=
# Optional coordination pool cap per serverless process (default 3, max 10)
DB_COORDINATION_POOL_MAX=
# Opt-in cutover only: set 1 to hold the old one-arg advisory lock while
# pre-lease instances overlap. Normal deployments drain old instances and keep 0.
LIFECYCLE_ADVISORY_COMPAT=0

# Canonical public origin, e.g. https://your-domain.example
APP_URL=

# Stripe server-side configuration
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MXN=
STRIPE_PRICE_ID_USD=
# Optional comma-separated legacy Premium price IDs
STRIPE_PREMIUM_PRICE_IDS=

# Optional commercial Open-Meteo key (server only)
OPEN_METEO_API_KEY=

# Optional public map-tile URL template and plain-text provider attribution.
# These values are visible in the browser; never put a private secret here.
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=

# Maximum upstream geocoding calls per hour (default 1000)
PLACES_HOURLY_BUDGET=

# Email delivery. Local development defaults to "outbox" and writes .mail-outbox/*.eml.
# Staging and production must use "resend" or "postmark" with the matching key.
MAIL_TRANSPORT=
MAIL_FROM=
MAIL_REPLY_TO=
RESEND_API_KEY=
POSTMARK_SERVER_TOKEN=

# CSP rollout: keep "report-only" until the observation window is clean, then set "enforce".
CSP_MODE=report-only

# Local-only seed scaffold (never set in staging or production; refused when CI/VERCEL is set)
# Guard: ALLOW_LOCAL_SEED must be "true" and DATABASE_URL must be loopback (localhost/127.0.0.1/::1/[::1]); host check is best-effort (tunnels appear as 127.0.0.1)
ALLOW_LOCAL_SEED=
# Set ALLOW_LOCAL_SEED_IN_CI=true only for disposable CI DB (127.0.0.1) to allow seeding subscription fixtures / gating checks
ALLOW_LOCAL_SEED_IN_CI=
# Shared password for local seeded accounts (min 12 chars, never commit a real value)
LOCAL_SEED_PASSWORD=

# --- Reading generation safety (#105/#108/#129) -----------------------------
# Keep OFF through safety rollout and until provider evaluation + output UI are ready.
READINGS_GENERATION_ENABLED=
# Account generation accepts only "chat-completions" with the profile below.
# "fixture" is for explicit offline pipeline simulations, never a real account fallback.
READINGS_PROVIDER=
READINGS_CHEAP_MODEL=
READINGS_STRONG_MODEL=
# MXN per million tokens. Must price the requested model and every declared served alias.
# Aliases currently must have identical rates to the requested model. No fixture defaults.
# {"model-id":{"inputMxnPerMillion":15,"outputMxnPerMillion":60}}
READINGS_MODEL_PRICES=
# Canonical HTTPS base URL, no credentials, query or fragment; redirects refused.
READINGS_API_BASE_URL=
# NON-SECRET processor policy and verified whole-input metering contract:
# {"id":"processor-id","name":"Actual processor name","policyVersion":"v1","inputTokenLimits":{"model-id":128000},"servedModels":{"model-id":["served-id"]}}
# Verify limits include ALL billed input (system/schema/framing). The full input
# cap is reserved, not a guessed token count. Unknown/incomplete profiles refuse dispatch.
# Provider/endpoint/privacy version changes require fresh consent; model changes never reset the offer.
READINGS_PROCESSOR_PROFILE=
# Add this LAST, directly in the secret manager; never in chat/Git or preview data.
READINGS_API_KEY=
# Per-attempt deadline INCLUDING response body: integer 1..15000 ms, default 15000.
# Whole dispatch budget 40s; durable run 45s; hosting must support the 60s route duration.
READINGS_REQUEST_TIMEOUT_MS=
