# Local database connection (do not commit real credentials)
DATABASE_URL=

# Canonical public origin, e.g. https://your-domain.example
APP_URL=

# Stripe server-side configuration
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MXN=
STRIPE_PRICE_ID_USD=
# Optional comma-separated legacy Premium price IDs
STRIPE_PREMIUM_PRICE_IDS=

# Optional commercial Open-Meteo key (server only)
OPEN_METEO_API_KEY=

# Optional public map-tile URL template and plain-text provider attribution.
# These values are visible in the browser; never put a private secret here.
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=
